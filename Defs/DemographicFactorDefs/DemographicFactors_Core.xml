      <li><source>RS_Stratification</source><tier>RS_Agri_CashCrops</tier><weight>0.20</weight></li>
      <li><source>RS_Ideology</source><tier>Ascetic</tier><targetTier>RS_Agri_CashCrops</targetTier><weight>-0.40</weight></li>
      <li><source>RS_BiomeForest</source><tier>RS_Agri_Forestry</tier><weight>0.50</weight></li>
      <li><source>RS_Urbanisation</source><tier>RS_Agri_Forestry</tier><weight>0.20</weight></li>
    </influences>
