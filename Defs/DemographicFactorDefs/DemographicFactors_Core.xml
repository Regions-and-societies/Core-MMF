      <li><source>RS_MortalityRate</source><tier>RS_Agri_Medicinal</tier><weight>0.30</weight></li>
      <li><source>RS_Education</source><tier>Primary</tier><targetTier>RS_Agri_Medicinal</targetTier><weight>0.20</weight></li>
      <li><source>RS_Roads</source><tier>RS_Agri_CashCrops</tier><weight>0.40</weight></li>
