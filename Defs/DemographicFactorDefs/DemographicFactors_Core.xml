      <li><source>RS_AgeStructure</source><tier>WorkingAge</tier><weight>0.30</weight></li>
      <li><source>RS_Wealth</source><weight>0.20</weight></li>
      <li><source>RS_Roads</source><weight>0.20</weight></li>
      <li><source>RS_Conflict</source><weight>-0.30</weight></li>
      <li><source>RS_Stratification</source><weight>-0.30</weight><curve>Threshold</curve><threshold>0.5</threshold></li>
    </influences>
  </RegionsAndSocieties.Demographics.DemographicFactorDef>

  <RegionsAndSocieties.Demographics.DemographicFactorDef>
    <defName>RS_Sector</defName>
    <label>employment sector</label>
    <description>Top-level mix of those in work. Tiers are the ROOT EconomicSectorDefs (Agriculture / Extraction / Manufacturing / Services / Military / Public); each root has its own sub-distribution below. The fastest-moving distribution: a job is easy to change.</description>
    <category>Mutable</category>
    <kind>Distribution</kind>
    <tiersFrom>EconomicSectorDef:roots</tiersFrom>
    <velocity>0.6</velocity>
    <inertia>0.1</inertia>
    <deadband>0.02</deadband>
    <releaseBand>0.01</releaseBand>
    <maxStepPerYear>0.15</maxStepPerYear>
    <influences>
      <li><source>RS_BiomeFertility</source><tier>RS_Agriculture</tier><weight>0.50</weight></li>
      <li><source>RS_Urbanisation</source><tier>RS_Agriculture</tier><weight>-0.40</weight></li>
      <li><source>RS_MineralPool</source><tier>RS_Extraction</tier><weight>0.50</weight></li>
      <li><source>RS_StonePool</source><tier>RS_Extraction</tier><weight>0.20</weight></li>
      <li><source>RS_Education</source><tier>Secondary</tier><targetTier>RS_Manufacturing</targetTier><weight>0.50</weight></li>
      <li><source>RS_Urbanisation</source><tier>RS_Manufacturing</tier><weight>0.30</weight></li>
      <li><source>RS_Roads</source><tier>RS_Services</tier><weight>0.40</weight></li>
      <li><source>RS_Urbanisation</source><tier>RS_Services</tier><weight>0.30</weight></li>
      <li><source>RS_Wealth</source><tier>RS_Services</tier><weight>0.20</weight></li>
      <li><source>RS_Conflict</source><tier>RS_Military</tier><weight>0.50</weight></li>
      <li><source>RS_FactionCharacter</source><tier>Militarism</tier><targetTier>RS_Military</targetTier><weight>0.40</weight></li>
      <li><source>RS_Stratification</source><tier>RS_Public</tier><weight>0.30</weight></li>
      <li><source>RS_Population</source><tier>RS_Public</tier><weight>0.20</weight><curve>Saturating</curve></li>
    </influences>
  </RegionsAndSocieties.Demographics.DemographicFactorDef>

  <!-- Sub-sector distributions: one per root, tiers = that root's child EconomicSectorDefs. Same fast pace
       as RS_Sector. 0.4.0 scaffolds the levels and the pull edges; 0.5.0 adds production/consumption. -->

