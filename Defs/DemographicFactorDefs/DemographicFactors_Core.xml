    <velocity>0.6</velocity><inertia>0.1</inertia><deadband>0.02</deadband><releaseBand>0.01</releaseBand><maxStepPerYear>0.15</maxStepPerYear>
    <influences>
      <li><source>RS_Population</source><tier>RS_Agri_Food</tier><weight>0.40</weight></li>
      <li><source>RS_SES</source><tier>Subsistence</tier><targetTier>RS_Agri_Food</targetTier><weight>0.30</weight></li>
